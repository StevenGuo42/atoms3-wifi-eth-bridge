# M5Stack AtomS3 Lite (ESP32-S3, 8 MB flash, no PSRAM) on the AtomPoE base (W5500).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# W5500 wiring on the AtomS3, from espressif/arduino-esp32#9246. The base's
# printed labels are for the ESP32 Atom. INT and RST aren't connected: the
# driver polls. These aren't the SPI2 IO_MUX pins, so SPI stays at the
# default 20 MHz (26 max).
CONFIG_BRIDGE_PIN_MOSI=8
CONFIG_BRIDGE_PIN_MISO=7
CONFIG_BRIDGE_PIN_SCLK=5
CONFIG_BRIDGE_PIN_CS=6
CONFIG_BRIDGE_PIN_INT=-1
CONFIG_BRIDGE_PIN_RST=-1

CONFIG_BRIDGE_ETH_AUTONEGOTIATE=y

# The button on top: GPIO41, not yet verified on hardware.
CONFIG_BRIDGE_PIN_WPS_BUTTON=41
